         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Guide is an introduction to programming your analyzer over the HP-IB. Its purpose is to provide concise information about the operation of the instrument under HP-IB control. It provides some background information on the HP-IB (formerly GPIB) and some short programming examples to demonstrate the remote operation of the analyzer.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">8712ET/ES and 8714ET/ES RF Network Analyzers Programmer's Guide</rdf:li>
            </rdf:Alt>
         </dc:title>
         <pdf:Producer>Acrobat Distiller 3.01 for Windows</pdf:Producer>
