         <dc:creator>
            <rdf:Seq>
               <rdf:li>Mac Freeman</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">For use with Keysight 8712ES and 8714ES using firmware revisions E.06.00 and above.  The first several chapters of this User's Guide explain how to perform measurements, calibrate the instrument, and use the most common instrument functions of the Keysight 8712ES/14ES RF Network Analyzers. The remaining chapters are reference material. Use these chapters to look up information such as front panel features, specific key functions, and specifications.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">8712ES and 8714ES RF Network Analyzers User's Guide</rdf:li>
            </rdf:Alt>
         </dc:title>
         <pdf:Producer>Acrobat Distiller 3.01 for Windows</pdf:Producer>
      </rdf:Description>
   </rdf:RDF>
