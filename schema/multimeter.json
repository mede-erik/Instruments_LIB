{
  "schema_version": 1,
  "category": "multimeters_series",
  "description": "Logical calls of bench digital multimeters (one input). Mandatory calls are those documented by every multimeter manual of the library and doable with text commands.",
  "types": {
    "bool": {
      "kind": "bool",
      "description": "true/false"
    },
    "meter_function": {
      "kind": "enum",
      "values": [
        "DC_VOLTAGE",
        "DC_VOLTAGE_RATIO",
        "AC_VOLTAGE",
        "DC_CURRENT",
        "AC_CURRENT",
        "RESISTANCE_2W",
        "RESISTANCE_4W",
        "FREQUENCY",
        "PERIOD",
        "CONTINUITY",
        "DIODE",
        "EXTENDED_RESISTANCE"
      ],
      "description": "measurement function; EXTENDED_RESISTANCE is the HP 3478A extended-ohms mode"
    },
    "autozero_mode": {
      "kind": "enum",
      "values": [
        "OFF",
        "ON",
        "ONCE"
      ]
    },
    "trigger_source": {
      "kind": "enum",
      "values": [
        "IMMEDIATE",
        "BUS",
        "EXTERNAL"
      ],
      "description": "IMMEDIATE = internal/continuous, BUS = software or GPIB trigger, EXTERNAL = rear input"
    },
    "float_list": {
      "kind": "list",
      "item": "float",
      "description": "list of readings"
    }
  },
  "calls": {
    "set_function": {
      "requirement": "mandatory",
      "kind": "set",
      "description": "select the measurement function",
      "args": {
        "function": {
          "type": "meter_function"
        }
      }
    },
    "set_range": {
      "requirement": "mandatory",
      "kind": "set",
      "description": "fixed measurement range: the smallest range of the instrument that contains this value (in the unit of the function)",
      "args": {
        "function": {
          "type": "meter_function",
          "required": false,
          "description": "function the setting applies to; needed by instruments whose command names it (34401A)"
        },
        "range": {
          "type": "float",
          "min": 0
        }
      }
    },
    "set_auto_range": {
      "requirement": "mandatory",
      "kind": "set",
      "description": "autoranging on/off",
      "args": {
        "function": {
          "type": "meter_function",
          "required": false,
          "description": "function the setting applies to; needed by instruments whose command names it (34401A)"
        },
        "state": {
          "type": "bool"
        }
      }
    },
    "set_autozero": {
      "requirement": "mandatory",
      "kind": "set",
      "description": "autozero mode",
      "args": {
        "mode": {
          "type": "autozero_mode"
        }
      }
    },
    "set_trigger_source": {
      "requirement": "mandatory",
      "kind": "set",
      "description": "trigger source",
      "args": {
        "source": {
          "type": "trigger_source"
        }
      }
    },
    "read_measurement": {
      "requirement": "mandatory",
      "kind": "query",
      "description": "take (or read) one reading in the configured function",
      "result": {
        "type": "float"
      }
    },
    "clear_status": {
      "requirement": "mandatory",
      "kind": "action",
      "description": "clear the status registers"
    },
    "error_query": {
      "requirement": "mandatory",
      "kind": "query",
      "description": "read one error (34401A error queue; HP 3478A error register, two octal digits)",
      "result": {
        "type": "string"
      }
    },
    "reset": {
      "requirement": "optional",
      "kind": "action",
      "description": "restore the power-on state (the HP 3478A needs the GPIB device clear, which is not a text command)"
    },
    "trigger_bus": {
      "requirement": "optional",
      "kind": "action",
      "description": "software trigger (34401A *TRG; the HP 3478A needs the GPIB Group Execute Trigger, not a text command)"
    },
    "identification_query": {
      "requirement": "optional",
      "kind": "query",
      "description": "identification string (*IDN?)",
      "result": {
        "type": "string"
      }
    },
    "query_function": {
      "requirement": "optional",
      "kind": "query",
      "description": "measurement function in use",
      "result": {
        "type": "meter_function"
      }
    },
    "query_trigger_source": {
      "requirement": "optional",
      "kind": "query",
      "description": "trigger source",
      "result": {
        "type": "trigger_source"
      }
    },
    "query_front_rear_input": {
      "requirement": "optional",
      "kind": "query",
      "description": "front/rear input switch (true = front)",
      "result": {
        "type": "bool"
      }
    },
    "fetch_readings": {
      "requirement": "optional",
      "kind": "query",
      "description": "readings stored by initiate_measurement",
      "result": {
        "type": "float_list"
      }
    },
    "self_test": {
      "requirement": "optional",
      "kind": "query",
      "description": "complete self test, returns 0 = pass, 1 = fail",
      "result": {
        "type": "int"
      }
    },
    "query_status_byte": {
      "requirement": "optional",
      "kind": "query",
      "description": "query status byte summary register",
      "result": {
        "type": "int"
      }
    },
    "query_event_status_register": {
      "requirement": "optional",
      "kind": "query",
      "description": "query standard event register (clears it)",
      "result": {
        "type": "int"
      }
    },
    "enable_event_status_register": {
      "requirement": "optional",
      "kind": "set",
      "description": "enable standard event register bits",
      "args": {
        "enable_value": {
          "type": "int"
        }
      }
    },
    "query_event_status_enable": {
      "requirement": "optional",
      "kind": "query",
      "description": "query standard event enable register",
      "result": {
        "type": "int"
      }
    },
    "enable_status_byte_register": {
      "requirement": "optional",
      "kind": "set",
      "description": "enable status byte register bits (SRQ)",
      "args": {
        "enable_value": {
          "type": "int"
        }
      }
    },
    "query_status_byte_enable": {
      "requirement": "optional",
      "kind": "query",
      "description": "query status byte enable register",
      "result": {
        "type": "int"
      }
    },
    "operation_complete": {
      "requirement": "optional",
      "kind": "action",
      "description": "set OPC bit (bit 0) in standard event register when done"
    },
    "operation_complete_query": {
      "requirement": "optional",
      "kind": "query",
      "description": "returns 1 when all prior commands complete",
      "result": {
        "type": "int"
      }
    },
    "set_power_on_status_clear": {
      "requirement": "optional",
      "kind": "set",
      "description": "power-on status clear: clear enable masks at power-on",
      "args": {
        "state": {
          "type": "string"
        }
      }
    },
    "query_power_on_status_clear": {
      "requirement": "optional",
      "kind": "query",
      "description": "query power-on status clear",
      "result": {
        "type": "int"
      }
    },
    "measure_dc_voltage": {
